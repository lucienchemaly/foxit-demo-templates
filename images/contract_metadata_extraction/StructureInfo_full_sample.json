      },
      {
        "type": "head",
        "content": {
          "text": "2. Term and Renewal",
          "style": {
            "fontEmbedded": false,
            "fontEncoding": "UTF-8",
            "fontFamilyName": "Arial",
            "fontType": "Type1",
            "fontItalic": false,
